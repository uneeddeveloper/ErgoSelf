// ═══════════════════════════════════════════════════════════════════════════
//  ErgoSelf — Skema Basis Data
//  Tesis: Pengukuran Mandiri Keluhan Musculoskeletal Disorders pada Pengguna
//         Komputer Menggunakan CMDQ Berbasis Aplikasi
//  Magister Terapan K3 — Universitas Gadjah Mada
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // Catatan TiDB: jika memakai TiDB Cloud Serverless versi lama yang belum
  // mendukung FOREIGN KEY, aktifkan baris di bawah lalu jalankan `prisma db push`.
  // relationMode = "prisma"
}

// ───────────────────────────────────────────────────────────────────────────
//  ENUM
// ───────────────────────────────────────────────────────────────────────────

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

/// Klasifikasi IMT sesuai Kemenkes RI (Depkes, 2003)
///   < 17,0        Kurus — kekurangan BB tingkat berat
///   17,0 – < 18,5 Kurus — kekurangan BB tingkat ringan
///   18,5 – 25,0   Normal
///   > 25,0 – 27,0 Gemuk — kelebihan BB tingkat ringan
///   > 27,0        Obesitas
enum KategoriImt {
  KURUS_BERAT
  KURUS_RINGAN
  NORMAL
  GEMUK_RINGAN
  OBESITAS
}

enum Sisi {
  TENGAH
  KIRI
  KANAN
}

/// Pengelompokan regional 18 item CMDQ, untuk analisis deskriptif per regio
/// di Bab IV
enum RegioTubuh {
  LEHER
  BAHU
  PUNGGUNG_PINGGANG
  EKSTREMITAS_ATAS
  EKSTREMITAS_BAWAH
}

/// Tangan yang dinilai pada CHDQ. Cornell menerbitkan dua berkas terpisah
/// (`rhandq.pdf` & `lhandq.pdf`), dan keduanya diisi responden.
enum TanganChdq {
  KANAN
  KIRI
}

/// Instrumen yang ambang tersilnya disimpan di `ambang_risiko`
enum InstrumenAmbang {
  CMDQ
  CHDQ
}

enum KategoriRisiko {
  RENDAH
  SEDANG
  TINGGI
}

/// Rentang akseptabilitas SUS (Bangor, Kortum & Miller, 2009)
enum SusInterpretasi {
  NOT_ACCEPTABLE // < 50
  MARGINAL // 50 – 70
  ACCEPTABLE // > 70
}

enum StatusPengisian {
  BELUM
  BERLANGSUNG
  SELESAI
}

// ───────────────────────────────────────────────────────────────────────────
//  AUTENTIKASI PENELITI
// ───────────────────────────────────────────────────────────────────────────

model Admin {
  id           Int      @id @default(autoincrement())
  nama         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @db.VarChar(255)
  dibuatPada   DateTime @default(now())
  diubahPada   DateTime @updatedAt

  @@map("admin")
}

// ───────────────────────────────────────────────────────────────────────────
//  1. PROFIL PEKERJA / RESPONDEN
// ───────────────────────────────────────────────────────────────────────────

model Responden {
  id Int @id @default(autoincrement())

  // ── Akun (dibuat pada langkah 1: Registrasi) ────────────────────────────
  /// Kode anonim responden untuk pelaporan & ekspor (mis. "PTX-001").
  /// Bukan kredensial — masuk memakai email + kata sandi.
  kodeResponden String  @unique @db.VarChar(32)
  nama          String  @db.VarChar(120)
  email         String  @unique @db.VarChar(160)
  passwordHash  String? @db.VarChar(255) // Tambahkan tanda ? di sini

  /// Persetujuan etik penelitian (informed consent). Wajib dicentang saat
  /// registrasi; tanggalnya direkam sebagai bukti kepatuhan etik riset.
  setujuEtik         Boolean   @default(false)
  tanggalPersetujuan DateTime?

  // ── Data sosiodemografis (diisi pada langkah 2, terpisah dari registrasi) ─
  // Seluruh kolom di bawah opsional DI BASIS DATA karena akun sudah ada
  // sebelum profil terisi — bukan karena boleh dikosongkan. Kewajiban
  // mengisinya ditegakkan di `lib/validasi/responden.ts`; kelengkapannya
  // ditandai oleh `statusProfil`.
  //
  // Kolom kategorik menyimpan LABEL PILIHANNYA SENDIRI ("23-28 Thn"), bukan
  // kode angka — daftar sahnya ada di `lib/sosiodemografi.ts`. Jangan pernah
  // membandingkannya dengan `gte`/`lte`: pada VARCHAR, "> 52 Thn" terurut
  // sebelum "17-22 Thn".

  // — Karakteristik individu —
  usia         String?       @db.VarChar(20)
  jenisKelamin JenisKelamin?

  // — Karakteristik okupasional —
  //
  // Divisi & jabatan kini dikelola lewat CMS di panel admin (tabel `divisi` &
  // `jabatan`), tidak lagi dari daftar tetap di dalam kode.
  //
  // KOLOM TEKS DI BAWAH SENGAJA DIPERTAHANKAN di samping foreign key-nya, dan
  // itu bukan duplikasi yang terlewat. Keduanya menjawab pertanyaan berbeda:
  //   - `divisiId`  → "divisi mana pada struktur organisasi saat ini"
  //   - `divisi`    → "apa nama divisi ini SAAT responden mengisinya"
  // Ketika admin mengganti nama sebuah divisi setelah pengumpulan data
  // berjalan, tabulasi silang harus tetap memakai nama yang berlaku saat itu;
  // kalau label ikut berubah surut, dua kelompok responden yang dikumpulkan
  // pada struktur organisasi berbeda tergabung diam-diam menjadi satu sel.
  //
  // Kolom teks juga menampung jawaban "Lainnya" — teks yang diketik responden
  // ketika divisinya tidak ada di daftar. Pada baris seperti itu `divisiId`
  // bernilai NULL, dan itulah satu-satunya cara membedakan keduanya.

  /// Nama divisi sebagaimana berlaku saat responden mengisi profil
  divisi   String? @db.VarChar(120)
  /// Acuan ke master divisi; NULL bila responden mengisi lewat "Lainnya"
  divisiId Int?

  /// Nama jabatan sebagaimana berlaku saat responden mengisi profil
  jabatan   String? @db.VarChar(120)
  /// Acuan ke master jabatan; NULL bila responden mengisi lewat "Lainnya"
  jabatanId Int?
  /// Sub-bagian/seksi — keterangan bebas yang lebih rinci dari divisi.
  /// Satu-satunya kolom sosiodemografis yang memang opsional bagi responden.
  unitKerja String? @db.VarChar(120)

  /// Masa kerja dalam kategori rentang tahun
  masaKerjaTahun           String? @db.VarChar(20)
  /// Rata-rata durasi penggunaan komputer per hari dalam rentang (jam)
  durasiKomputerJamPerHari String? @db.VarChar(20)

  // — Antropometri —
  tinggiBadanCm Decimal?     @db.Decimal(5, 1)
  beratBadanKg  Decimal?     @db.Decimal(5, 1)
  /// IMT = berat(kg) / tinggi(m)² — dihitung server-side, disimpan agar
  /// dashboard bisa memfilter & mengagregasi tanpa kalkulasi ulang.
  imt           Decimal?     @db.Decimal(5, 2)
  kategoriImt   KategoriImt?

  // — Faktor risiko individu —
  olahraga                   Boolean?
  frekuensiOlahragaPerMinggu Int?     @db.SmallInt
  merokok                    Boolean?
  riwayatMsds                Boolean?
  keteranganRiwayatMsds      String?  @db.Text

  // — Status pengisian (dipakai kolom "progress" di dashboard) —
  statusProfil StatusPengisian @default(BELUM)
  statusCmdq   StatusPengisian @default(BELUM)
  statusChdq   StatusPengisian @default(BELUM)
  statusSus    StatusPengisian @default(BELUM)

  dibuatPada DateTime @default(now())
  diubahPada DateTime @updatedAt

  cmdqJawaban CmdqJawaban[]
  cmdqHasil   CmdqHasil?
  chdqJawaban ChdqJawaban[]
  chdqHasil   ChdqHasil?
  susJawaban  SusJawaban[]
  susHasil    SusHasil?

  // Master divisi/jabatan TIDAK boleh terhapus selama masih dirujuk responden;
  // panel admin menonaktifkannya (`aktif = false`) alih-alih menghapus.
  divisiRef  Divisi?  @relation(fields: [divisiId], references: [id], onDelete: Restrict)
  jabatanRef Jabatan? @relation(fields: [jabatanId], references: [id], onDelete: Restrict)

  @@index([jenisKelamin])
  @@index([kategoriImt])
  @@index([usia])
  @@index([divisi])
  @@index([jabatan])
  @@index([divisiId])
  @@index([jabatanId])
  @@map("responden")
}

// ───────────────────────────────────────────────────────────────────────────
//  1b. MASTER DIVISI & JABATAN (dikelola lewat CMS di panel admin)
//
//     Sebelumnya kedua daftar ini adalah konstanta di `lib/sosiodemografi.ts`,
//     sehingga menyesuaikannya dengan struktur organisasi lokasi penelitian
//     menuntut perubahan kode dan penerapan ulang aplikasi. Kini peneliti
//     mengelolanya sendiri dari panel admin sebelum pengumpulan data dimulai.
//
//     `urutan` menentukan susunan tombol pada form profil; `aktif` menyembunyikan
//     pilihan dari responden baru TANPA menghapus jejak responden lama.
// ───────────────────────────────────────────────────────────────────────────

model Divisi {
  id     Int     @id @default(autoincrement())
  nama   String  @unique @db.VarChar(120)
  urutan Int     @default(0)
  aktif  Boolean @default(true)

  dibuatPada DateTime @default(now())
  diubahPada DateTime @updatedAt

  responden Responden[]

  @@index([aktif, urutan])
  @@map("divisi")
}

model Jabatan {
  id     Int     @id @default(autoincrement())
  nama   String  @unique @db.VarChar(120)
  urutan Int     @default(0)
  aktif  Boolean @default(true)

  dibuatPada DateTime @default(now())
  diubahPada DateTime @updatedAt

  responden Responden[]

  @@index([aktif, urutan])
  @@map("jabatan")
}

// ───────────────────────────────────────────────────────────────────────────
//  2. MASTER BAGIAN TUBUH — 18 item CMDQ versi pekerja duduk (indeks 0–17)
//
//     SUMBER KEBENARAN INSTRUMEN ADALAH `lib/cmdq/segmen.ts`, BUKAN TABEL INI.
//     `hitungSkorCmdq()` memvalidasi kelengkapan jawaban terhadap konstanta
//     `SEGMEN_TUBUH` di berkas tersebut, tidak pernah terhadap basis data.
//     Mengubah isi tabel ini lewat seed TIDAK mengubah instrumen — ia hanya
//     membuat kedua sisi tidak sinkron dan menolak setiap pengiriman CMDQ.
//
//     Tabel ini ada untuk menyediakan target foreign key yang stabil bagi
//     `cmdq_jawaban`, sehingga integritas referensial jawaban terjaga dan
//     analisis per segmen dapat dilakukan langsung di SQL.
// ───────────────────────────────────────────────────────────────────────────

model SegmenTubuh {
  id     Int        @id @default(autoincrement())
  /// Kode stabil, dipakai sebagai id elemen <path> pada body map SVG
  kode   String     @unique @db.VarChar(48)
  nama   String     @db.VarChar(80) // label bahasa Indonesia (UI responden)
  namaEn String     @db.VarChar(80) // istilah asli form Cornell (lampiran tesis)
  sisi   Sisi       @default(TENGAH)
  regio  RegioTubuh
  /// Nomor item CMDQ (0–17), sekaligus urutan tampil atas → bawah
  urutan Int        @unique
  /// Penanda dokumentasi saja — TIDAK dibaca oleh query mana pun. Instrumen
  /// harus selalu lengkap 18 item; menonaktifkan satu item akan membuat
  /// validasi kelengkapan gagal untuk seluruh responden.
  aktif  Boolean    @default(true)

  jawaban        CmdqJawaban[]
  hasilTertinggi CmdqHasil[]   @relation("SegmenSkorTertinggi")

  @@index([regio])
  @@map("segmen_tubuh")
}

// ───────────────────────────────────────────────────────────────────────────
//  3. JAWABAN CMDQ (satu baris per responden per segmen)
// ───────────────────────────────────────────────────────────────────────────

model CmdqJawaban {
  id          Int @id @default(autoincrement())
  respondenId Int
  segmenId    Int

  /// Indeks pilihan frekuensi 0–4, sesuai lima kolom pada form Cornell:
  ///   0 = Tidak pernah        | 1 = 1–2× minggu lalu | 2 = 3–4× minggu lalu
  ///   3 = Sekali setiap hari  | 4 = Beberapa kali setiap hari
  frekuensiKode  Int     @db.SmallInt
  /// Bobot frekuensi baku CMDQ: 0 | 1,5 | 3,5 | 5 | 10. Disimpan terpisah dari
  /// `frekuensiKode` supaya hasil lama tetap dapat direproduksi bila tabel
  /// bobot direvisi. Decimal(4,1) memang karena nilai 1,5 dan 3,5.
  frekuensiBobot Decimal @db.Decimal(4, 1)

  /// 1 = Sedikit | 2 = Cukup | 3 = Sangat tidak nyaman.
  /// NULL bila frekuensi = "Tidak pernah" (pertanyaan tidak ditampilkan),
  /// ATAU bila responden melewatkannya — aturan missing value Cornell
  /// memperlakukannya sebagai pengali 1, bukan sebagai jawaban "sedikit".
  /// Karena itu nilai penggantinya TIDAK dituliskan ke kolom ini.
  ketidaknyamananSkor Int? @db.SmallInt
  /// 1 = Tidak sama sekali | 2 = Sedikit | 3 = Sangat mengganggu. NULL, idem.
  gangguanSkor        Int? @db.SmallInt

  /// skor = frekuensiBobot × ketidaknyamanan × gangguan  (rentang 0–90)
  skor Decimal @db.Decimal(5, 2)

  dibuatPada DateTime @default(now())
  diubahPada DateTime @updatedAt

  responden Responden   @relation(fields: [respondenId], references: [id], onDelete: Cascade)
  segmen    SegmenTubuh @relation(fields: [segmenId], references: [id])

  @@unique([respondenId, segmenId])
  @@index([segmenId])
  @@map("cmdq_jawaban")
}

// ───────────────────────────────────────────────────────────────────────────
//  4. REKAP HASIL CMDQ PER RESPONDEN
// ───────────────────────────────────────────────────────────────────────────

model CmdqHasil {
  id          Int @id @default(autoincrement())
  respondenId Int @unique

  /// Metode 4 Cornell (skor utama): Σ skor seluruh item, 0 – 90 × 18 = 0–1620
  skorTotal              Decimal        @db.Decimal(7, 2)
  /// Rata-rata skor per item
  skorRataRata           Decimal        @db.Decimal(5, 2)
  /// Metode 1 Cornell: jumlah item dengan skor > 0 ("jumlah gejala")
  jumlahSegmenBermasalah Int            @db.SmallInt
  kategoriRisiko         KategoriRisiko
  segmenTertinggiId      Int?

  // ── Metode analisis Cornell lainnya ──────────────────────────────────────
  //
  // Instruksi resmi menyebut skor "can be analyzed in 4 ways". Ketiganya
  // disimpan, bukan dihitung ulang saat ekspor, supaya angka di dasbor, berkas
  // Excel, dan Bab IV berasal dari satu perhitungan yang sama.

  /// Metode 2: Σ (frekuensiKode + ketidaknyamanan + gangguan), missing = 0
  jumlahRating            Int     @db.SmallInt
  /// Metode 3: Σ bobot frekuensi (0–180)
  jumlahFrekuensiBerbobot Decimal @db.Decimal(6, 2)
  /// Banyaknya item berkeluhan yang pertanyaan lanjutannya kosong — penanda
  /// kualitas data, bukan bagian skor.
  jumlahSegmenNilaiHilang Int     @default(0) @db.SmallInt

  /// Nilai ambang & jumlah item yang berlaku saat perhitungan — direkam agar
  /// hasil tetap dapat direproduksi setelah ambang tersil dihitung ulang.
  jumlahSegmenDinilai Int     @db.SmallInt
  ambangSedang        Decimal @db.Decimal(7, 2)
  ambangTinggi        Decimal @db.Decimal(7, 2)

  selesaiPada DateTime @default(now())
  diubahPada  DateTime @updatedAt

  responden       Responden    @relation(fields: [respondenId], references: [id], onDelete: Cascade)
  segmenTertinggi SegmenTubuh? @relation("SegmenSkorTertinggi", fields: [segmenTertinggiId], references: [id])

  @@index([kategoriRisiko])
  @@index([segmenTertinggiId])
  @@map("cmdq_hasil")
}

// ───────────────────────────────────────────────────────────────────────────
//  4b. CHDQ — CORNELL HAND DISCOMFORT QUESTIONNAIRE
//
//      Instrumen TERPISAH dari CMDQ, bukan tambahan item padanya. CMDQ versi
//      pekerja duduk berhenti di "Wrist"; telapak tangan dan jari ditanyakan
//      oleh berkas Cornell sendiri (`rhandq.pdf` & `lhandq.pdf`), dengan enam
//      area per tangan.
//
//      Skala, bobot, dan aturan missing value-nya identik dengan CMDQ, jadi
//      struktur tabelnya sengaja dibuat sejajar — bukan disatukan. Menyatukan
//      keduanya dalam satu tabel jawaban akan memaksa setiap kueri analisis
//      menyaring instrumen mana yang dimaksud, dan satu kelalaian menyaring
//      menghasilkan skor total yang mencampur dua instrumen berbeda.
// ───────────────────────────────────────────────────────────────────────────

/// Master 12 area tangan (6 area × 2 tangan). Sumber kebenarannya
/// `lib/chdq/area.ts`; tabel ini menyediakan target foreign key yang stabil.
model AreaTangan {
  id     Int        @id @default(autoincrement())
  /// Kode stabil, mis. "KANAN_A"
  kode   String     @unique @db.VarChar(24)
  tangan TanganChdq
  /// Huruf area sebagaimana tertulis di form Cornell (A–F)
  huruf  String     @db.VarChar(1)
  /// Glosa anatomis bahasa Indonesia (keterangan pendamping diagram)
  nama   String     @db.VarChar(80)
  /// Nomor item CHDQ (0–11), sekaligus urutan tampil
  urutan Int        @unique

  jawaban        ChdqJawaban[]
  hasilTertinggi ChdqHasil[]   @relation("AreaSkorTertinggi")

  @@index([tangan])
  @@map("area_tangan")
}

model ChdqJawaban {
  id          Int @id @default(autoincrement())
  respondenId Int
  areaId      Int

  /// Indeks pilihan frekuensi 0–4 — skala sama persis dengan CMDQ
  frekuensiKode  Int     @db.SmallInt
  /// Bobot baku Cornell: 0 | 1,5 | 3,5 | 5 | 10
  frekuensiBobot Decimal @db.Decimal(4, 1)

  ketidaknyamananSkor Int? @db.SmallInt
  gangguanSkor        Int? @db.SmallInt

  /// skor = frekuensiBobot × ketidaknyamanan × gangguan  (rentang 0–90)
  skor Decimal @db.Decimal(5, 2)

  dibuatPada DateTime @default(now())
  diubahPada DateTime @updatedAt

  responden Responden  @relation(fields: [respondenId], references: [id], onDelete: Cascade)
  area      AreaTangan @relation(fields: [areaId], references: [id])

  @@unique([respondenId, areaId])
  @@index([areaId])
  @@map("chdq_jawaban")
}

model ChdqHasil {
  id          Int @id @default(autoincrement())
  respondenId Int @unique

  /// Σ skor kedua tangan (0 – 90 × 12 = 0–1080)
  skorTotal            Decimal        @db.Decimal(7, 2)
  /// Skor per tangan (0–540). Disimpan terpisah karena keluhan tangan pada
  /// pengguna komputer kerap satu sisi saja — mengikuti tangan yang memegang
  /// tetikus — dan skor gabungan meratakan justru pola itu.
  skorTanganKanan      Decimal        @db.Decimal(6, 2)
  skorTanganKiri       Decimal        @db.Decimal(6, 2)
  /// Tangan berskor lebih tinggi; NULL bila seri (termasuk saat keduanya 0)
  tanganDominan        TanganChdq?
  jumlahAreaBermasalah Int            @db.SmallInt
  kategoriRisiko       KategoriRisiko
  areaTertinggiId      Int?

  /// Metode analisis Cornell 2 & 3 (metode 1 = `jumlahAreaBermasalah`,
  /// metode 4 = `skorTotal`)
  jumlahRating            Int     @db.SmallInt
  jumlahFrekuensiBerbobot Decimal @db.Decimal(6, 2)
  jumlahAreaNilaiHilang   Int     @default(0) @db.SmallInt

  jumlahAreaDinilai Int     @db.SmallInt
  ambangSedang      Decimal @db.Decimal(7, 2)
  ambangTinggi      Decimal @db.Decimal(7, 2)

  selesaiPada DateTime @default(now())
  diubahPada  DateTime @updatedAt

  responden     Responden   @relation(fields: [respondenId], references: [id], onDelete: Cascade)
  areaTertinggi AreaTangan? @relation("AreaSkorTertinggi", fields: [areaTertinggiId], references: [id])

  @@index([kategoriRisiko])
  @@index([areaTertinggiId])
  @@map("chdq_hasil")
}

// ───────────────────────────────────────────────────────────────────────────
//  4c. AMBANG KATEGORI RISIKO (tersil empiris)
//
//      Cornell tidak menyediakan cut-off dan menyatakannya eksplisit: kuesioner
//      ini "for research screening purposes and not for diagnostic purposes".
//      Batas RENDAH/SEDANG/TINGGI karena itu keputusan analisis peneliti, dan
//      diperlakukan sebagai DATA yang bisa dihitung ulang — bukan konstanta di
//      dalam kode.
//
//      Satu baris per instrumen. Setiap hasil responden merekam sendiri ambang
//      yang dipakainya, sehingga menghitung ulang ambang tidak diam-diam
//      mengubah makna hasil yang sudah dilaporkan.
// ───────────────────────────────────────────────────────────────────────────

model AmbangRisiko {
  id        Int             @id @default(autoincrement())
  instrumen InstrumenAmbang @unique

  ambangSedang Decimal @db.Decimal(7, 2)
  ambangTinggi Decimal @db.Decimal(7, 2)

  /// Persentil yang dipakai (33,3 & 66,7 untuk tersil)
  persentilSedang Decimal @db.Decimal(4, 1)
  persentilTinggi Decimal @db.Decimal(4, 1)

  /// Banyaknya responden yang skornya ikut dihitung
  jumlahResponden Int     @db.SmallInt
  /// FALSE berarti masih memakai nilai sementara dari `lib/*/skala.ts` karena
  /// data belum mencukupi — dasbor menampilkannya sebagai peringatan.
  dariData        Boolean @default(false)
  /// Peringatan hasil perhitungan terakhir (mis. sebaran terlalu terpusat)
  catatan         String? @db.Text

  dihitungPada DateTime @default(now())
  diubahPada   DateTime @updatedAt

  @@map("ambang_risiko")
}

// ───────────────────────────────────────────────────────────────────────────
//  5. JAWABAN SUS (10 item, Likert 1–5)
// ───────────────────────────────────────────────────────────────────────────

model SusJawaban {
  id          Int @id @default(autoincrement())
  respondenId Int

  /// 1–10 sesuai urutan baku kuesioner SUS (Brooke, 1996)
  itemNomor   Int @db.SmallInt
  /// 1 = Sangat Tidak Setuju … 5 = Sangat Setuju
  skorJawaban Int @db.SmallInt

  dibuatPada DateTime @default(now())
  diubahPada DateTime @updatedAt

  responden Responden @relation(fields: [respondenId], references: [id], onDelete: Cascade)

  @@unique([respondenId, itemNomor])
  @@map("sus_jawaban")
}

// ───────────────────────────────────────────────────────────────────────────
//  6. HASIL SUS PER RESPONDEN
// ───────────────────────────────────────────────────────────────────────────

model SusHasil {
  id          Int @id @default(autoincrement())
  respondenId Int @unique

  /// Σ kontribusi item × 2,5 → rentang 0–100
  skorTotal      Decimal         @db.Decimal(5, 2)
  interpretasi   SusInterpretasi
  /// Grade huruf (A–F) — Sauro & Lewis (2016)
  gradeHuruf     String          @db.VarChar(2)
  /// Adjective rating — Bangor et al. (2009)
  adjektif       String          @db.VarChar(40)
  /// Apakah memenuhi target penelitian (skor ≥ 68 = rata-rata industri)
  memenuhiTarget Boolean

  selesaiPada DateTime @default(now())
  diubahPada  DateTime @updatedAt

  responden Responden @relation(fields: [respondenId], references: [id], onDelete: Cascade)

  @@index([interpretasi])
  @@map("sus_hasil")
}
