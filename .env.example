# ── Database ────────────────────────────────────────────────────────────────
# TiDB Cloud Serverless — wajib TLS. `sslaccept=strict` memakai sertifikat CA
# bawaan sistem; TiDB Cloud memakai CA publik sehingga tidak perlu berkas CA
# terpisah. Bila password memuat karakter khusus (@ : / ?), URL-encode dulu.
DATABASE_URL="mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/ergoself?sslaccept=strict"

# MySQL lokal (cadangan untuk pengembangan luring)
# DATABASE_URL="mysql://root:@localhost:3306/ergoself"

# CATATAN: berkas .env hanya dibaca saat `npm run dev`. Pada build produksi
# (`node .output/server/index.mjs`) seluruh nilai di bawah harus disetel
# sebagai environment variable sungguhan di hosting.

# ── Sesi / autentikasi (nuxt-auth-utils) ────────────────────────────────────
# Minimal 32 karakter. Buat baru dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=""

# ── Akun admin/peneliti awal (dipakai oleh `npm run db:seed`) ───────────────
ADMIN_EMAIL="peneliti@ugm.ac.id"
ADMIN_PASSWORD=""
ADMIN_NAMA="Peneliti"
